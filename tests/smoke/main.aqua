# Headless-capable smoke test: builds a small scene, renders frames and writes a screenshot.
變數 濾 = 匯入("/bottles/Aqua_Filament/main.aqua");
變數 無值 = 濾.無值;
變數 資訊 = 濾.開啟視窗({"標題":"Aqua_Filament smoke / 冒煙測試", "寬度":640, "高度":360});
印出("後端 / backend:", 資訊["後端"], 資訊["寬度"], 資訊["高度"]);
濾.設定相機([0, 1.5d, 4], [0, 0.5d, 0], [0, 1, 0]);
濾.加入太陽光([-0.5d, -1, -0.3d], [1, 0.95d, 0.9d], 100000, {"陰影":{"貼圖尺寸":1024}});
變數 紅 = 濾.標準材質({"基礎色":[0.9d, 0.15d, 0.1d, 1], "粗糙度":0.3d});
變數 灰 = 濾.標準材質({"基礎色":[0.6d, 0.6d, 0.6d, 1], "粗糙度":0.8d});
變數 球 = 濾.加入球體(0.6d, 紅, {"位置":[0, 0.6d, 0]});
濾.加入平面(8, 8, 灰, 無值);
變數 方塊 = 濾.加入方塊([0.5d, 0.5d, 0.5d], 紅, {"位置":[1.3d, 0.25d, 0], "旋轉":[0, 30, 0]});
濾.設定畫面({"泛光":{"強度":0.1d}, "環境遮蔽":真, "色調映射":"ACES"});
迴圈 (變數 i = 0; i < 20; i++) {
    濾.設定旋轉(方塊, [0, i * 9, 0]);
    濾.繪製畫面();
}
變數 截圖結果 = 濾.截圖("smoke.png");
變數 統計 = 濾.統計();
印出("物件數 / objects:", 統計["物件數"], "光源數 / lights:", 統計["光源數"]);
濾.關閉視窗();
印出("AQUA_FILAMENT_SMOKE_OK");
